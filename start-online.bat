@echo off
chcp 65001 > nul
title تشغيل نظام النقوصات أونلاين (عبر الإنترنت والهواتف)
echo ===================================================================
echo             جاري تشغيل نظام نقوصات منخل عبر الإنترنت
echo ===================================================================
echo.
echo 1. جاري تشغيل خادم النظام...
start "Mankhul-Server" /min node server.js
timeout /t 2 > nul

echo 2. جاري إنشاء رابط إنترنت مباشر وخاص (HTTPS)...
echo.
echo ===================================================================
echo  📱 الآن يمكن فتح الموقع من أي هاتف في العالم ببيانات الهاتف (4G/5G)
echo ===================================================================
echo.
cloudflared.exe tunnel --url http://localhost:3000
pause
