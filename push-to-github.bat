@echo off
chcp 65001 > nul
title رفع نظام منخل إلى GitHub
echo ===================================================================
echo             جاري رفع ملفات نظام منخل إلى حسابك في GitHub...
echo ===================================================================
echo.
echo سيظهر لك الآن متصفح أو نافذة منبثقة لتأكيد تسجيل الدخول بحسابك (munkhul).
echo فقط اضغط (Authorize) للموافقة وسيتم الرفع فوراً!
echo.
echo ===================================================================
cd /d "d:\نقوصات منخل"
git branch -M main
git push -u origin main
echo.
echo ===================================================================
if %ERRORLEVEL% EQU 0 (
    echo  تم الرفع بنجاح إلى مستودعك: https://github.com/munkhul/mun
) else (
    echo  حدث خطأ أو لم يتم تأكيد الدخول. يرجى إعادة المحاولة.
)
echo ===================================================================
pause
